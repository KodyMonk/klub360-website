---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getArtists } from '../lib/data';

// Managed in the admin panel → Artists.
const artists = await getArtists();
---
<Base title="Artists" current="artists" description="Artists who have played Klub360 in Bahrain, from Afterlife and progressive house to global headline acts.">
  <PageHead eyebrow="Artists" title="Who's played" accent="KLUB360°." lead="From Afterlife and progressive house to global headline acts, these are the artists who have taken over our booth." />

  <section class="container section-end">
    <div class="artist-list">
      {artists.map((a, i) => (
        <div class="artist">
          <div style="display: flex; align-items: center; gap: 20px; min-width: 0">
            <span class="numeral" style="font-size: 16px; min-width: 28px">{String(i + 1).padStart(2, '0')}</span>
            {a.photo && <img src={a.photo} alt="" width="48" height="48" loading="lazy" style="width: 48px; height: 48px; border-radius: 999px; object-fit: cover; flex-shrink: 0" />}
            <span class="name">{a.name}</span>
          </div>
          <div class="links">
            {a.instagram && <a href={a.instagram} rel="noopener">Instagram</a>}
            {a.other && <a href={a.other.href} rel="noopener" class="dim">{a.other.label}</a>}
          </div>
        </div>
      ))}
    </div>

    <div class="card card-pad row-between" style="margin-top: 72px; align-items: center">
      <h2 class="h2" style="font-size: clamp(32px, 3.4vw, 48px)">Who's <span class="serif">next?</span></h2>
      <a class="btn btn-primary" href="/events/">See upcoming events <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
