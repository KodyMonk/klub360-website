---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="container page-head section-end">
    <p class="eyebrow">404</p>
    <h1 class="display">Lost on the <span class="serif silver">dance floor.</span></h1>
    <p class="lead">This page doesn't exist. Try one of these instead.</p>
    <div class="actions" style="margin-top: 40px">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn" href="/events/">Events</a>
      <a class="btn" href="/table/">Book a table</a>
    </div>
  </section>
</Base>
