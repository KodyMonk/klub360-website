# Copy this file to ".env" and fill in the two values from
# Supabase → Project Settings → API.
# Both are safe to expose in the browser (security is handled by the
# database rules in supabase/schema.sql).

PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
